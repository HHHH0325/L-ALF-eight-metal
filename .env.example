# Required only for LLM-backed methods. Keep the real key in an untracked .env.
OPENAI_API_KEY=
OPENAI_MODEL=

# Leave empty for the official OpenAI endpoint; otherwise use a compatible /v1 URL.
OPENAI_BASE_URL=
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=1
OPENAI_TEMPERATURE=0.2
OPENAI_INVERSE_DESIGN_MAX_TOKENS=120
OPENAI_PREDICTION_MAX_TOKENS=20
